// Prisma Schema for Owshika Enterprises Billing Application

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  customers Customer[]
  invoices  Invoice[]
}

model Product {
  id         String   @id @default(uuid())
  partNumber String
  name       String
  hsn        String
  gst        Float
  price      Float
  unit       String
  stock      Int      @default(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  invoiceItems InvoiceItem[]

  @@unique([userId, partNumber])
  @@index([partNumber])
  @@index([name])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  @@index([userId])
}

model Invoice {
  id               String   @id @default(uuid())
  invoiceNumber    String
  invoiceDate      DateTime @default(now())
  billType         String   @default("CUSTOMER")
  customerName     String
  customerPhone    String?
  customerAddress  String?
  paymentMode      String   @default("CASH")
  transportDetails Json?
  subtotal         Float
  discountTotal    Float    @default(0)
  cgstTotal        Float
  sgstTotal        Float
  igstTotal        Float    @default(0)
  roundOff         Float    @default(0)
  grandTotal       Float
  amountInWords    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer?     @relation(fields: [customerId], references: [id])
  items      InvoiceItem[]

  @@unique([userId, invoiceNumber])
  @@index([userId])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  partNumber  String
  productName String
  hsn         String
  unit        String
  quantity    Float
  price       Float
  discount    Float    @default(0)
  gstRate     Float
  gstAmount   Float
  total       Float
}

// Global store settings — shared by all users, not per-user
model StoreSetting {
  id            String   @id @default(uuid())
  storeName     String   @default("OWSHIKA ENTERPRISES")
  ownerName     String   @default("C.Perumal")
  email         String   @default("owshikaentt@gmail.com")
  gstin         String   @default("33BAEPP2449B1Z3")
  phone         String   @default("+91 9445662637")
  address       String   @default("4/783, Roller Flour Mills, Near New Bus Stand, Salem Main Road, Dharmapuri - 636701")
  bankName      String   @default("")
  accountNumber String   @default("")
  ifscCode      String   @default("")
  branchName    String   @default("")
  upiId         String   @default("")
  updatedAt     DateTime @updatedAt
}
